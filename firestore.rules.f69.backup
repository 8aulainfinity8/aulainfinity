rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.role == 'admin';
    }

    function isTeacher() {
      return isVerifiedUser() && (
        request.auth.token.role == 'teacher' ||
        request.auth.token.role == 'admin'
      );
    }

    function isApprovedTeacher() {
      return isVerifiedUser() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role == 'teacher' && request.auth.token.isApprovedForTutoring == true)
      );
    }

    // Helper to verify participant in communication structures
    function isParticipant(data) {
      return isVerifiedUser() && (
        isAdmin() ||
        (data != null && (
          (data.participants is list && request.auth.uid in data.participants) ||
          (data.participantIds is list && request.auth.uid in data.participantIds) ||
          (data.studentId is string && data.studentId == request.auth.uid) ||
          (data.teacherId is string && data.teacherId == request.auth.uid) ||
          (data.createdBy is string && data.createdBy == request.auth.uid) ||
          (data.senderId is string && data.senderId == request.auth.uid) ||
          (data.recipientId is string && data.recipientId == request.auth.uid) ||
          (data.userId is string && data.userId == request.auth.uid)
        ))
      );
    }

    function isIdParticipant(id) {
      return isVerifiedUser() && (
        isAdmin() ||
        id == request.auth.uid ||
        id.matches('^direct_' + request.auth.uid + '(_.*)?$') ||
        id.matches('^peer_' + request.auth.uid + '(_.*)?$') ||
        id.matches('^room_' + request.auth.uid + '(_.*)?$') ||
        id.matches('^call_' + request.auth.uid + '(_.*)?$') ||
        id.matches('^' + request.auth.uid + '_.*') ||
        id.matches('.*_' + request.auth.uid + '$') ||
        id.matches('.*_' + request.auth.uid + '_.*')
      );
    }

    function isEnrolledInCourse(courseId) {
      return isVerifiedUser() && request.auth.token.role == 'student' &&
             courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('enrolledCourseIds', []);
    }

    function isTeacherOfCourse(courseId) {
      return isVerifiedUser() && request.auth.token.role == 'teacher' && (
        courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('taughtCourseIds', []) ||
        courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coursesTaughtIds', []) ||
        courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('levels', [])
      );
    }


    // 1. App Configuration (Public read, Admin write)
    match /app_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Users Collection (/users/{userId} & /firestore_users/{userId})
    // Prevents privilege escalation: client cannot elevate to teacher/admin or self-approve tutoring
    match /users/{userId} {
      allow read: if isVerifiedUser();
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'student' &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('isApprovedForTutoring' in request.resource.data) || request.resource.data.isApprovedForTutoring == false)
      ) || isAdmin();
      allow update: if isOwner(userId) && (
        request.resource.data.role == resource.data.role &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) &&
        (!('isApprovedForTutoring' in request.resource.data) || request.resource.data.isApprovedForTutoring == resource.data.isApprovedForTutoring)
      ) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
      
      match /{allSubcollections=**} {
        allow read: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher());
        allow write: if isVerifiedUser() && (isOwner(userId) || isAdmin());
      }
    }

    match /firestore_users/{userId} {
      allow read: if isVerifiedUser();
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'student' &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('isApprovedForTutoring' in request.resource.data) || request.resource.data.isApprovedForTutoring == false)
      ) || isAdmin();
      allow update: if isOwner(userId) && (
        request.resource.data.role == resource.data.role &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) &&
        (!('isApprovedForTutoring' in request.resource.data) || request.resource.data.isApprovedForTutoring == resource.data.isApprovedForTutoring)
      ) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      match /{allSubcollections=**} {
        allow read: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher());
        allow write: if isVerifiedUser() && (isOwner(userId) || isAdmin());
      }
    }

    // Role-specific collections
    match /students/{userId} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher());
      match /{allSubcollections=**} {
        allow read: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher());
        allow write: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher());
      }
    }

    match /teachers/{teacherId} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser() && (isOwner(teacherId) || isAdmin());
      match /{allSubcollections=**} {
        allow read: if isVerifiedUser();
        allow write: if isVerifiedUser() && (isOwner(teacherId) || isAdmin());
      }
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // 3. Courses, Levels, Subjects, Modules, Lessons, Videos, Quizzes
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isApprovedTeacher();
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isApprovedTeacher();
      }
    }

    match /course_levels/{levelId} {
      allow read: if true;
      allow write: if isApprovedTeacher();
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isApprovedTeacher();
      }
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isApprovedTeacher();
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isApprovedTeacher();
      }
    }

    match /videos/{videoId} {
      allow read: if true;
      allow write: if isApprovedTeacher();
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isApprovedTeacher();
      }
    }

    match /firestore_quizzes/{quizId} {
      allow read: if isVerifiedUser();
      allow write: if isApprovedTeacher();
      match /{allSubcollections=**} {
        allow read: if isVerifiedUser();
        allow write: if isApprovedTeacher();
      }
    }

    match /quiz_answers/{answerId} {
      allow read: if isVerifiedUser() && (
        isAdmin() ||
        (resource.data != null && resource.data.studentId == request.auth.uid) ||
        isParticipant(resource.data) ||
        isIdParticipant(answerId)
      );
      allow create: if isVerifiedUser() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 4. Tutoring Requests & Topic Requests
    match /firestore_tutoring_requests/{requestId} {
      allow read: if isVerifiedUser() && (
        isAdmin() ||
        (resource.data != null && (
          resource.data.studentId == request.auth.uid ||
          resource.data.teacherId == request.auth.uid
        )) ||
        isApprovedTeacher() ||
        isParticipant(resource.data) ||
        isIdParticipant(requestId)
      );
      allow create: if isVerifiedUser() && request.resource.data.studentId == request.auth.uid;
      allow update: if isVerifiedUser() && (
        isAdmin() ||
        (resource.data != null && request.resource.data.studentId == resource.data.studentId && (
          (resource.data.studentId == request.auth.uid && (resource.data.status == 'pending' || resource.data.status == 'cancelled')) ||
          (resource.data.teacherId == request.auth.uid) ||
          isApprovedTeacher() ||
          isParticipant(resource.data)
        ))
      );
      allow delete: if isVerifiedUser() && (
        isAdmin() ||
        (resource.data != null && resource.data.studentId == request.auth.uid && resource.data.status == 'pending')
      );
    }

    match /firestore_topic_requests/{requestId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser() && request.resource.data.studentId == request.auth.uid;
      allow update: if isVerifiedUser() && (
        isAdmin() ||
        (resource.data != null && request.resource.data.studentId == resource.data.studentId && (
          resource.data.studentId == request.auth.uid ||
          isApprovedTeacher()
        ))
      );
      allow delete: if isVerifiedUser() && (
        isAdmin() ||
        (resource.data != null && resource.data.studentId == request.auth.uid) ||
        isApprovedTeacher()
      );
    }

    match /exam_events/{eventId} {
      allow read: if isVerifiedUser();
      allow write: if isApprovedTeacher();
    }

    // 5. Communications, Rooms, Calls, Whiteboards
    // Aislamiento estricto de participantes y autoría de mensajes (Fase 1)
    match /chats/{chatId} {
      // Función para validar pertenencia al chat (recurso existente o por ID)
      function isChatParticipant() {
        return isVerifiedUser() && (
          isAdmin() ||
          isIdParticipant(chatId) ||
          isEnrolledInCourse(chatId) ||
          isTeacherOfCourse(chatId) ||
          (resource != null && (
            (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
            (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds) ||
            (resource.data.studentId == request.auth.uid) ||
            (resource.data.teacherId == request.auth.uid)
          ))
        );
      }

      // Lectura: solo participantes legítimos o admin
      allow get, list: if isChatParticipant();

      // Creación: el usuario debe ser parte de los participantes o del chatId
      allow create: if isVerifiedUser() && (
        isAdmin() ||
        (
          (isIdParticipant(chatId) || (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants)) &&
          (!('participants' in request.resource.data) || (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants))
        )
      );

      // Actualización: participantes pueden actualizar estado operativo (lastMessage, unreadCount, etc.)
      // pero participants, type, chatId, createdBy, createdAt son inmutables para no-admins.
      allow update: if isChatParticipant() && (
        isAdmin() || (
          (!('participants' in request.resource.data) || !('participants' in resource.data) || request.resource.data.participants == resource.data.participants) &&
          (!('type' in request.resource.data) || !('type' in resource.data) || request.resource.data.type == resource.data.type) &&
          (!('chatId' in request.resource.data) || !('chatId' in resource.data) || request.resource.data.chatId == resource.data.chatId) &&
          (!('createdBy' in request.resource.data) || !('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy) &&
          (!('createdAt' in request.resource.data) || !('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        )
      );

      // Borrado: exclusivo para administradores
      allow delete: if isAdmin();

      // Subcolección de mensajes con validación de autoría estricta
      match /messages/{messageId} {
        // Lectura de mensajes: participantes del chat o admin
        allow get, list: if isVerifiedUser() && (
          isAdmin() ||
          isIdParticipant(chatId) ||
          isEnrolledInCourse(chatId) ||
          isTeacherOfCourse(chatId) ||
          (resource != null && (
            (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
            resource.data.senderId == request.auth.uid
          )) ||
          (exists(/databases/$(database)/documents/chats/$(chatId)) &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []) is list &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []))
        );

        // Creación de mensaje: debe ser participante del chat y senderId DEBE coincidir con el usuario autenticado
        allow create: if isVerifiedUser() && (
          isAdmin() || (
            (isIdParticipant(chatId) ||
             isEnrolledInCourse(chatId) ||
             isTeacherOfCourse(chatId) ||
             (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants) ||
             (exists(/databases/$(database)/documents/chats/$(chatId)) &&
              get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []) is list &&
              request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []))) &&
            request.resource.data.senderId == request.auth.uid
          )
        );

        // Edición de mensaje: solo el autor original (o admin), inmutabilidad de senderId y campos críticos
        allow update: if isVerifiedUser() && (
          isAdmin() || (
            resource.data.senderId == request.auth.uid &&
            request.resource.data.senderId == resource.data.senderId &&
            (!('chatId' in request.resource.data) || !('chatId' in resource.data) || request.resource.data.chatId == resource.data.chatId) &&
            (!('timestamp' in request.resource.data) || !('timestamp' in resource.data) || request.resource.data.timestamp == resource.data.timestamp)
          )
        );

        // Borrado de mensaje: solo el autor original (o admin)
        allow delete: if isVerifiedUser() && (
          isAdmin() ||
          resource.data.senderId == request.auth.uid
        );
      }

      // Subcolección de señalización WebRTC del chat (para useVoiceCall)
      match /signal/{signalDoc=**} {
        allow read, write: if isVerifiedUser() && (
          isAdmin() ||
          isIdParticipant(chatId) ||
          (resource != null && resource.data.participants is list && request.auth.uid in resource.data.participants)
        );
      }

      // Otras subcolecciones de chat restringidas a participantes
      match /{otherSubcollection}/{docId=**} {
        allow read, write: if isVerifiedUser() && (
          isAdmin() ||
          isIdParticipant(chatId) ||
          (resource != null && resource.data.participants is list && request.auth.uid in resource.data.participants)
        );
      }
    }

    match /rooms/{roomId} {
      // Función para validar si el usuario es participante legítimo de la sala WebRTC
      function isRoomParticipant() {
        return isVerifiedUser() && (
          isAdmin() ||
          isIdParticipant(roomId) ||
          (roomId.matches('^room_.*') && (
            isEnrolledInCourse(roomId[5:]) ||
            isTeacherOfCourse(roomId[5:])
          )) ||
          (resource != null && (
            (resource.data.callerUid is string && resource.data.callerUid == request.auth.uid) ||
            (resource.data.calleeUid is string && resource.data.calleeUid == request.auth.uid) ||
            (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
            (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds) ||
            (resource.data.studentId is string && resource.data.studentId == request.auth.uid) ||
            (resource.data.teacherId is string && resource.data.teacherId == request.auth.uid)
          ))
        );
      }

      // Lectura: participante legítimo o admin
      allow get, list: if isRoomParticipant();

      // Creación: debe ser participante en el roomId o callerUid / participants
      allow create: if isVerifiedUser() && (
        isAdmin() ||
        (
          (isIdParticipant(roomId) ||
           (roomId.matches('^room_.*') && (isEnrolledInCourse(roomId[5:]) || isTeacherOfCourse(roomId[5:]))) ||
           (request.resource.data.callerUid is string && request.resource.data.callerUid == request.auth.uid) ||
           (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants)) &&
          (!('callerUid' in request.resource.data) || request.resource.data.callerUid == request.auth.uid)
        )
      );

      // Actualización: participantes pueden actualizar SDP/estado (offer, answer, status, updatedAt),
      // pero no alterar participantes ni creadores (callerUid, roomId, courseId, createdBy)
      allow update: if isRoomParticipant() && (
        isAdmin() || (
          (!('callerUid' in request.resource.data) || !('callerUid' in resource.data) || request.resource.data.callerUid == resource.data.callerUid) &&
          (!('roomId' in request.resource.data) || !('roomId' in resource.data) || request.resource.data.roomId == resource.data.roomId) &&
          (!('courseId' in request.resource.data) || !('courseId' in resource.data) || request.resource.data.courseId == resource.data.courseId) &&
          (!('createdBy' in request.resource.data) || !('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy) &&
          (!('createdAt' in request.resource.data) || !('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        )
      );

      // Borrado: participantes de la sala o admin
      allow delete: if isRoomParticipant();

      // Subcolección de candidatos ICE: callerCandidates
      match /callerCandidates/{candidateId} {
        allow read, write: if isRoomParticipant();
      }

      // Subcolección de candidatos ICE: calleeCandidates
      match /calleeCandidates/{candidateId} {
        allow read, write: if isRoomParticipant();
      }

      // Otras subcolecciones de la sala
      match /{subcollection}/{docId=**} {
        allow read, write: if isRoomParticipant();
      }
    }

    match /calls/{callId} {
      // Función para validar si el usuario es participante de la llamada directa
      function isCallParticipant() {
        return isVerifiedUser() && (
          isAdmin() ||
          isIdParticipant(callId) ||
          (resource != null && (
            (resource.data.callerUid is string && resource.data.callerUid == request.auth.uid) ||
            (resource.data.calleeUid is string && resource.data.calleeUid == request.auth.uid) ||
            (resource.data.callerId is string && resource.data.callerId == request.auth.uid) ||
            (resource.data.calleeId is string && resource.data.calleeId == request.auth.uid) ||
            (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
            (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds) ||
            (resource.data.studentId is string && resource.data.studentId == request.auth.uid) ||
            (resource.data.teacherId is string && resource.data.teacherId == request.auth.uid)
          ))
        );
      }

      allow get, list: if isCallParticipant();
      allow create: if isVerifiedUser() && (
        isAdmin() ||
        isIdParticipant(callId) ||
        (request.resource.data.callerUid is string && request.resource.data.callerUid == request.auth.uid) ||
        (request.resource.data.callerId is string && request.resource.data.callerId == request.auth.uid) ||
        (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants)
      );
      allow update: if isCallParticipant();
      allow delete: if isCallParticipant();

      match /{allSubcollections=**} {
        allow read, write: if isCallParticipant();
      }
    }

    match /voice_group_calls/{callId} {
      // Función para validar pertenencia a la llamada de grupo de curso
      function isVoiceGroupCallMember() {
        return isVerifiedUser() && (
          isAdmin() ||
          isIdParticipant(callId) ||
          isEnrolledInCourse(callId) ||
          isTeacherOfCourse(callId) ||
          (resource != null && (
            (resource.data.courseId is string && (isEnrolledInCourse(resource.data.courseId) || isTeacherOfCourse(resource.data.courseId))) ||
            (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
            (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds)
          ))
        );
      }

      allow get, list: if isVoiceGroupCallMember();
      allow create: if isVerifiedUser() && (
        isAdmin() ||
        isEnrolledInCourse(callId) ||
        isTeacherOfCourse(callId) ||
        (request.resource.data.courseId is string && (
          isEnrolledInCourse(request.resource.data.courseId) ||
          isTeacherOfCourse(request.resource.data.courseId)
        ))
      );
      allow update: if isVoiceGroupCallMember();
      allow delete: if isVoiceGroupCallMember();

      match /{allSubcollections=**} {
        allow read, write: if isVoiceGroupCallMember();
      }
    }

    match /whiteboards/{whiteboardId} {
      // Función para validar si el usuario tiene acceso legítimo a la pizarra digital
      function isWhiteboardParticipant() {
        return isVerifiedUser() && (
          isAdmin() ||
          isIdParticipant(whiteboardId) ||
          isEnrolledInCourse(whiteboardId) ||
          isTeacherOfCourse(whiteboardId) ||
          (whiteboardId.matches('^whiteboard_.*') && (
            isEnrolledInCourse(whiteboardId[11:]) ||
            isTeacherOfCourse(whiteboardId[11:])
          )) ||
          (resource != null && (
            (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
            (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds) ||
            (resource.data.studentId is string && resource.data.studentId == request.auth.uid) ||
            (resource.data.teacherId is string && resource.data.teacherId == request.auth.uid) ||
            (resource.data.createdBy is string && resource.data.createdBy == request.auth.uid) ||
            (resource.data.userId is string && resource.data.userId == request.auth.uid) ||
            (resource.data.courseId is string && (isEnrolledInCourse(resource.data.courseId) || isTeacherOfCourse(resource.data.courseId)))
          ))
        );
      }

      // Lectura: participante legítimo o admin
      allow get, list: if isWhiteboardParticipant();

      // Creación: participante legítimo según whiteboardId o datos iniciales
      allow create: if isVerifiedUser() && (
        isAdmin() ||
        isIdParticipant(whiteboardId) ||
        isEnrolledInCourse(whiteboardId) ||
        isTeacherOfCourse(whiteboardId) ||
        (whiteboardId.matches('^whiteboard_.*') && (
          isEnrolledInCourse(whiteboardId[11:]) ||
          isTeacherOfCourse(whiteboardId[11:])
        )) ||
        (request.resource.data.courseId is string && (
          isEnrolledInCourse(request.resource.data.courseId) ||
          isTeacherOfCourse(request.resource.data.courseId)
        )) ||
        (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants) ||
        (request.resource.data.studentId is string && request.resource.data.studentId == request.auth.uid) ||
        (request.resource.data.teacherId is string && request.resource.data.teacherId == request.auth.uid) ||
        (request.resource.data.createdBy is string && request.resource.data.createdBy == request.auth.uid) ||
        (request.resource.data.userId is string && request.resource.data.userId == request.auth.uid)
      );

      // Actualización: inmutabilidad de campos estructurales (whiteboardId, courseId, participants, studentId, teacherId, createdBy, createdAt, type)
      allow update: if isWhiteboardParticipant() && (
        isAdmin() || (
          (!('whiteboardId' in request.resource.data) || !('whiteboardId' in resource.data) || request.resource.data.whiteboardId == resource.data.whiteboardId) &&
          (!('courseId' in request.resource.data) || !('courseId' in resource.data) || request.resource.data.courseId == resource.data.courseId) &&
          (!('studentId' in request.resource.data) || !('studentId' in resource.data) || request.resource.data.studentId == resource.data.studentId) &&
          (!('teacherId' in request.resource.data) || !('teacherId' in resource.data) || request.resource.data.teacherId == resource.data.teacherId) &&
          (!('tutoringRequestId' in request.resource.data) || !('tutoringRequestId' in resource.data) || request.resource.data.tutoringRequestId == resource.data.tutoringRequestId) &&
          (!('type' in request.resource.data) || !('type' in resource.data) || request.resource.data.type == resource.data.type) &&
          (!('participants' in request.resource.data) || !('participants' in resource.data) || request.resource.data.participants == resource.data.participants) &&
          (!('createdBy' in request.resource.data) || !('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy) &&
          (!('createdAt' in request.resource.data) || !('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        )
      );

      // Borrado: participante de la pizarra o admin (permite clear canvas / desactivar)
      allow delete: if isWhiteboardParticipant();

      // Subcolección de trazos /strokes/{strokeId}
      match /strokes/{strokeId} {
        allow get, list: if isWhiteboardParticipant();
        allow create: if isWhiteboardParticipant();
        allow update: if isWhiteboardParticipant();
        allow delete: if isWhiteboardParticipant();
      }

      // Subcolección de documentos adjuntos /documents/{docId}
      match /documents/{docId} {
        allow get, list: if isWhiteboardParticipant();
        allow create: if isWhiteboardParticipant();
        allow update: if isWhiteboardParticipant();
        allow delete: if isWhiteboardParticipant();
      }

      // Otras subcolecciones de la pizarra
      match /{subcollection}/{docId=**} {
        allow read, write: if isWhiteboardParticipant();
      }
    }

    match /whiteboardCursors/{cursorId} {
      // Función para validar si el usuario tiene acceso al cursor
      function canAccessCursor() {
        return isVerifiedUser() && (
          isAdmin() ||
          isIdParticipant(cursorId) ||
          (resource != null && (
            (resource.data.userId is string && resource.data.userId == request.auth.uid) ||
            (resource.data.courseId is string && (
              isEnrolledInCourse(resource.data.courseId) ||
              isTeacherOfCourse(resource.data.courseId) ||
              isIdParticipant(resource.data.courseId)
            ))
          ))
        );
      }

      // Lectura: participantes del curso o sala del cursor, o del propio cursor
      allow get: if canAccessCursor();
      allow list: if isVerifiedUser();

      // Creación: debe coincidir el cursorId con el usuario (o ser admin) y userId debe coincidir con request.auth.uid
      allow create: if isVerifiedUser() && (
        isAdmin() || (
          isIdParticipant(cursorId) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
          (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
          (!('participantId' in request.resource.data) || request.resource.data.participantId == request.auth.uid)
        )
      );

      // Actualización: solo el dueño de su propio cursor o admin
      allow update: if isVerifiedUser() && (
        isAdmin() || (
          isIdParticipant(cursorId) &&
          (!('userId' in resource.data) || resource.data.userId == request.auth.uid) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
        )
      );

      // Borrado: el dueño del cursor o admin
      allow delete: if isVerifiedUser() && (
        isAdmin() ||
        isIdParticipant(cursorId) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    match /conversations/{convId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data) || isApprovedTeacher());
      match /{allSubcollections=**} {
        allow read, write: if isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data) || isApprovedTeacher());
      }
    }

    match /firestore_conversations/{convId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data) || isApprovedTeacher());
      match /{allSubcollections=**} {
        allow read, write: if isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data) || isApprovedTeacher());
      }
    }

    match /firestore_direct_messages/{msgId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(msgId) || isParticipant(resource.data) || isApprovedTeacher());
    }

    match /firestore_peer_conversations/{convId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data) || isApprovedTeacher());
      match /{allSubcollections=**} {
        allow read, write: if isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data) || isApprovedTeacher());
      }
    }

    match /firestore_peer_messages/{msgId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(msgId) || isParticipant(resource.data) || isApprovedTeacher());
    }

    match /firestore_teacher_conversations/{convId} {
      allow read, write: if isApprovedTeacher() || (isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data)));
      match /{allSubcollections=**} {
        allow read, write: if isApprovedTeacher() || (isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data)));
      }
    }

    match /firestore_teacher_messages/{msgId} {
      allow read, write: if isApprovedTeacher() || (isVerifiedUser() && (isIdParticipant(msgId) || isParticipant(resource.data)));
    }

    // 6. Comments, Ratings, Transactions
    match /firestore_comments/{commentId} {
      allow read: if true;
      allow create: if isVerifiedUser() && (
        (request.resource.data.author != null && request.resource.data.author.id == request.auth.uid) ||
        (request.resource.data.userId != null && request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.studentId != null && request.resource.data.studentId == request.auth.uid)
      );
      allow update, delete: if isVerifiedUser() && (
        isAdmin() ||
        (resource.data != null && (
          (resource.data.author != null && resource.data.author.id == request.auth.uid) ||
          (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
          (resource.data.studentId != null && resource.data.studentId == request.auth.uid)
        ))
      );
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isVerifiedUser() && (
        (request.resource.data.userId != null && request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.author != null && request.resource.data.author.id == request.auth.uid) ||
        (request.resource.data.studentId != null && request.resource.data.studentId == request.auth.uid)
      );
      allow update, delete: if isVerifiedUser() && (
        isAdmin() ||
        (resource.data != null && (
          (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
          (resource.data.author != null && resource.data.author.id == request.auth.uid) ||
          (resource.data.studentId != null && resource.data.studentId == request.auth.uid)
        ))
      );
    }

    match /infinity_transactions/{txId} {
      allow read: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(txId) || isAdmin());
      allow write: if isAdmin();
    }

    match /student_payments/{paymentId} {
      allow read: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(paymentId) || isAdmin());
      allow write: if isAdmin();
    }

    match /student_expenses/{expenseId} {
      allow read: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(expenseId) || isAdmin());
      allow write: if isAdmin();
    }

    match /teacher_payments/{paymentId} {
      allow read: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(paymentId) || isAdmin());
      allow write: if isAdmin();
    }

match /firestore_course_messages/{msgId} {
       allow read: if isVerifiedUser() && (
         isAdmin() ||
         isEnrolledInCourse(resource.data.courseId) ||
         isTeacherOfCourse(resource.data.courseId)
       );
       allow create: if isVerifiedUser() && (
         isAdmin() ||
         isEnrolledInCourse(request.resource.data.courseId) ||
         isTeacherOfCourse(request.resource.data.courseId)
       );
       allow update: if isVerifiedUser() && (
         isAdmin() ||
         (isEnrolledInCourse(resource.data.courseId) && request.resource.data.courseId == resource.data.courseId) ||
         (isTeacherOfCourse(resource.data.courseId) && request.resource.data.courseId == resource.data.courseId)
       );
       allow delete: if isVerifiedUser() && (
         isAdmin() ||
         isEnrolledInCourse(resource.data.courseId) ||
         isTeacherOfCourse(resource.data.courseId)
       );
    }

    match /firestore_closed_conversations/{convId} {
       allow read, write: if isApprovedTeacher() || isAdmin();
    }

    // 7. Student Data & Logs
    match /student_course_progress/{id} {
      allow read: if isVerifiedUser() && (
        id.startsWith(request.auth.uid) ||
        (resource.data != null && resource.data.studentId == request.auth.uid) ||
        (resource.data != null && isTeacherOfCourse(resource.data.courseId)) ||
        isAdmin()
      );
      allow write: if isVerifiedUser() && (
        id.startsWith(request.auth.uid) ||
        (request.resource.data != null && request.resource.data.studentId == request.auth.uid) ||
        isAdmin()
      );
    }

    match /firestore_agenda_events/{id} {
      allow read, write: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(id));
    }

    match /student_friends/{id} {
      allow read, write: if isVerifiedUser() && (id.startsWith(request.auth.uid));
    }

    match /ai_query_logs/{id} {
      allow read, write: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(id));
    }

    match /firestore_deleted_items/{id} {
      allow read, write: if isAdmin();
    }

    match /firestore_user_seen_states/{userId} {
      allow read, write: if isVerifiedUser() && (isOwner(userId) || isAdmin());
    }

    // 8. Auxiliary & Operational Collections (Class Recordings, Whiteboard Assets, Notifications Queue)
    match /classRecordings/{recordingId} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser() && (isApprovedTeacher() || isAdmin());
    }

    match /whiteboardStrokes/{boardId} {
      allow read, write: if isVerifiedUser() && (
        isAdmin() ||
        isApprovedTeacher() ||
        isIdParticipant(boardId) ||
        isParticipant(resource.data) ||
        isEnrolledInCourse(boardId) ||
        isTeacherOfCourse(boardId)
      );
    }

    match /whiteboardDocs/{boardId} {
      allow read, write: if isVerifiedUser() && (
        isAdmin() ||
        isApprovedTeacher() ||
        isIdParticipant(boardId) ||
        isParticipant(resource.data) ||
        isEnrolledInCourse(boardId) ||
        isTeacherOfCourse(boardId)
      );
    }

    match /whatsapp_queue/{msgId} {
      allow read, write: if isVerifiedUser();
    }

    match /whatsapp_logs/{logId} {
      allow read, write: if isVerifiedUser();
    }

    match /tests/{testId} {
      allow read: if isVerifiedUser();
      allow write: if isApprovedTeacher() || isAdmin();
    }

    // Default deny fallback
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
